# Local environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored: never commit real keys.
#
# Supabase (used by the existing app):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
#
# Supabase service-role key (SERVER ONLY — required by the Admin Console's
# permission-checked server functions, which read cross-user data that RLS
# denies to ordinary user tokens):
# - Set it in your local `.env` for development and in your hosting
#   provider's server environment settings for production.
# - NEVER prefix it with VITE_, NEVER commit it, and NEVER send it to the
#   browser. Anyone holding it bypasses all row-level security.
SUPABASE_SERVICE_ROLE_KEY=
#
# Meta Model API (used only by server-side code, never in the browser):
# Create a key in the Model API dashboard at https://dev.meta.ai/
MODEL_API_KEY=
#
# Bachs incoming payments (SERVER ONLY — never prefix with VITE_, never commit):
# Create a sandbox key (payments:read + payments:write) in the Bachs Developer
# Portal. Live keys (sk_live_) are refused by the P2 client.
BACHS_API_KEY=
# Optional override for local testing only (localhost). Defaults to the Bachs
# sandbox (https://sandbox-api.bachs.io) for sk_sandbox_ keys. Any other host
# is refused: the client never sends the API key to unapproved endpoints.
BACHS_BASE_URL=
# Per-endpoint webhook signing secret from the Bachs Developer Portal
# (SERVER ONLY — never prefix with VITE_, never commit). During secret
# rotation, deploy the new value promptly: deliveries dual-sign for 24h.
BACHS_WEBHOOK_SECRET=
# Public origin of this app, used server-side to build Bachs checkout
# return URLs (SERVER ONLY — never trust browser-supplied origins).
# Examples: http://localhost:3000 (dev), https://<preview>.vercel.app,
# https://outrazo.com. Plain http allowed on localhost only.
APP_URL=

# Optional comma-separated HTTPS hostnames for public event image URLs
# outside the Supabase project and images.unsplash.com.
SOCIAL_IMAGE_HOSTS=
